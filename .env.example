# Chaves de IA do chat. Copie este arquivo para .env.local e preencha as que
# quiser habilitar. A ordem de fallback é: Groq -> OpenRouter -> Gemini.
# Todas as opções abaixo são gratuitas e não exigem cartão de crédito.

# Google Gemini (https://aistudio.google.com/apikey) — último recurso.
GEMINI_API_KEY=

# Groq (https://console.groq.com) — primário: rápido e com folga de tokens.
GROQ_API_KEY=

# OpenRouter (https://openrouter.ai/keys) — rede de segurança: roteia para
# modelos gratuitos (:free) com failover automático.
OPENROUTER_API_KEY=

# Alerta de visitas via ntfy (https://ntfy.sh). Todas server-only.
# NTFY_TOPIC é obrigatória para enviar alertas; sem ela nada é enviado.
NTFY_TOPIC=

# Servidor do ntfy. Opcional, padrão https://ntfy.sh.
NTFY_SERVER=

# Token de acesso para tópicos protegidos. Opcional.
NTFY_TOKEN=

# Segredo do link /api/owner?token=... que marca seu navegador como dono
# (sem alertas). Use ?token=...&off=1 para desmarcar.
OWNER_TOKEN=

# IPs do dono separados por vírgula. Opcional; nunca são logados.
OWNER_IPS=